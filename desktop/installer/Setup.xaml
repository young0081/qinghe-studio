<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="青禾 Studio · 安装" Width="920" Height="610" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFFEF5"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#415334"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#EAF1DE"/>
      <Setter Property="Foreground" Value="#587B3B"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="ButtonSurface" RenderTransformOrigin="0.5,0.5">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <Border x:Name="Hover" Background="White" Opacity="0" IsHitTestVisible="False"/>
              <Rectangle x:Name="FocusMark" Height="3" Margin="10,0,10,5" Fill="{TemplateBinding Foreground}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.14"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter><Setter TargetName="Hover" Property="Opacity" Value="0.25"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusMark" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#75AC45"/><Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="MinWidth" Value="162"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#415334"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="22" Height="22" Margin="0,0,12,0">
                <Rectangle x:Name="Box" Fill="#E2ECCF"/>
                <Path x:Name="Tick" Data="M 5,10 L 9,14 L 17,6" Stroke="White" StrokeThickness="2.5" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Fill" Value="#75AC45"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="Stroke" Value="#415334"/><Setter TargetName="Box" Property="StrokeThickness" Value="2"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#EEF4E5"/><Setter Property="Foreground" Value="#415334"/>
      <Setter Property="Padding" Value="14,12"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CaretBrush" Value="#587B3B"/><Setter Property="SelectionBrush" Value="#B8D99C"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
              <Rectangle x:Name="FocusLine" Height="2" Fill="#75AC45" VerticalAlignment="Bottom" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusLine" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#829A6B"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#415F32"/><Setter Property="Margin" Value="0,16,0,16"/></Style>
    <Style x:Key="Description" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="24"/><Setter Property="Foreground" Value="#78866A"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Background="#EEF4E5">
      <StackPanel Margin="32,84,32,0" VerticalAlignment="Top">
        <TextBlock Text="A LITTLE IDEA." Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="A WHOLE NEW WORLD." Style="{StaticResource Eyebrow}" Margin="0,5,0,0"/>
        <Image x:Name="Scene" Width="228" Height="279" Margin="0,16,0,12" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <TextBlock Text="把想法，搭成世界。" FontSize="20" FontWeight="SemiBold" Foreground="#587B3B"/>
        <TextBlock Text="你的模型 · 你的工具 · 你的工作台" FontSize="11" Foreground="#829A6B" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="32,0,0,32">
        <Rectangle Width="7" Height="7" Fill="#75AC45" Margin="0,0,8,0"/>
        <TextBlock Text="LOCAL FIRST / MADE TO BUILD" FontFamily="Consolas" FontSize="11" Foreground="#829A6B"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1" Margin="42,91,42,28">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="66"/></Grid.RowDefinitions>
      <Grid x:Name="Pages">
        <StackPanel x:Name="WelcomePage">
          <TextBlock Text="01 / WELCOME HOME" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="让灵感，&#10;有个开始的地方。" Style="{StaticResource Heading}" FontSize="34"/>
          <TextBlock Text="欢迎来到 青禾 Studio。&#10;把模型、代码与日常工具，放进同一个明亮工作台。" Style="{StaticResource Description}" Margin="0,0,0,24"/>
          <UniformGrid Columns="3">
            <StackPanel Background="#F0F4E8" Margin="0,0,8,0">
              <TextBlock Text="✦" FontSize="23" Foreground="#75AC45" Margin="16,12,0,3"/>
              <TextBlock Text="原生模型接口" FontWeight="SemiBold" FontSize="12" Margin="16,0,0,4"/>
              <TextBlock Text="三大协议支持" FontSize="10" Foreground="#829A6B" Margin="16,0,0,14"/>
            </StackPanel>
            <StackPanel Background="#F4F0DC" Margin="0,0,8,0">
              <TextBlock Text="▦" FontSize="23" Foreground="#B29848" Margin="16,12,0,3"/>
              <TextBlock Text="工具与自动化" FontWeight="SemiBold" FontSize="12" Margin="16,0,0,4"/>
              <TextBlock Text="从网页到桌面" FontSize="10" Foreground="#958969" Margin="16,0,0,14"/>
            </StackPanel>
            <StackPanel Background="#EAF2EC">
              <TextBlock Text="⌘" FontSize="23" Foreground="#729C86" Margin="16,12,0,3"/>
              <TextBlock Text="本地优先" FontWeight="SemiBold" FontSize="12" Margin="16,0,0,4"/>
              <TextBlock Text="作品留在身边" FontSize="10" Foreground="#819489" Margin="16,0,0,14"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="离线安装 · 无需 Node.js · 无需管理员权限" FontSize="11" Foreground="#939D83" Margin="0,24,0,0"/>
        </StackPanel>
        <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
          <TextBlock Text="02 / MAKE SOME ROOM" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="给工作台安个家。" Style="{StaticResource Heading}"/>
          <TextBlock Text="选择专用程序文件夹。项目和会话与安装位置分开保存。" Style="{StaticResource Description}" Margin="0,0,0,23"/>
          <Label Target="{Binding ElementName=InstallPath}" Content="安装位置" Padding="0" Foreground="#587B3B" Margin="0,0,0,9"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="InstallPath" AutomationProperties.AutomationId="InstallPath" AutomationProperties.Name="安装位置" FontSize="12" VerticalContentAlignment="Center"/>
            <Button x:Name="Browse" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="15,10" AutomationProperties.AutomationId="Browse"/>
          </Grid>
          <TextBlock Text="可使用原安装目录升级；请先保存任务并退出桌面版。" FontSize="11" Foreground="#939D83" Margin="0,9,0,27"/>
          <CheckBox x:Name="DesktopShortcut" Content="创建桌面快捷方式" IsChecked="True" AutomationProperties.AutomationId="DesktopShortcut"/>
          <TextBlock Text="自动添加开始菜单和系统卸载入口。&#10;只安装程序，不修改供应商配置、工作区或会话。" Style="{StaticResource Description}" FontSize="12" Margin="0,20,0,0"/>
        </StackPanel>
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed">
          <TextBlock Text="03 / BUILDING YOUR SPACE" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="正在搭建工作台。" Style="{StaticResource Heading}"/>
          <TextBlock Text="一点点准备，很快就能开始创造。&#10;安装在本地完成，不下载模型，也不连接供应商。" Style="{StaticResource Description}"/>
          <StackPanel x:Name="LoadingPixels" Orientation="Horizontal" Margin="0,42,0,26" AutomationProperties.Name="正在安装，请稍候">
            <Rectangle Width="18" Height="18" Fill="#75AC45" Margin="0,0,10,0"/>
            <Rectangle Width="18" Height="18" Fill="#9BCB70" Margin="0,0,10,0"/>
            <Rectangle Width="18" Height="18" Fill="#BCD89C" Margin="0,0,10,0"/>
            <Rectangle Width="18" Height="18" Fill="#D5E5BB"/>
          </StackPanel>
          <TextBlock x:Name="ProgressStatus" AutomationProperties.AutomationId="ProgressStatus" AutomationProperties.LiveSetting="Polite" FontSize="16" FontWeight="SemiBold" Foreground="#587B3B"/>
          <TextBlock x:Name="ProgressDetail" Text="请保持此窗口开启。安装期间暂不支持中断。" Style="{StaticResource Description}" FontSize="12" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel x:Name="FinishedPage" Visibility="Collapsed">
          <TextBlock Text="04 / READY TO BUILD" Style="{StaticResource Eyebrow}"/>
          <Border Width="52" Height="52" Background="#E2EFD5" HorizontalAlignment="Left" Margin="0,24,0,0">
            <Path Data="M 13,25 L 23,35 L 40,15" Stroke="#75AC45" StrokeThickness="4"/>
          </Border>
          <TextBlock Text="准备好了，开始创造。" Style="{StaticResource Heading}" FontSize="28"/>
          <TextBlock Text="打开工作台，选择项目文件夹，&#10;在「供应商与模型」中接入模型，就可以开始。" Style="{StaticResource Description}"/>
          <TextBlock x:Name="InstalledPath" AutomationProperties.AutomationId="InstalledPath" TextWrapping="Wrap" Foreground="#939D83" FontSize="11" Margin="0,22,0,24"/>
          <CheckBox x:Name="LaunchAfter" Content="完成后打开 青禾 Studio" AutomationProperties.AutomationId="LaunchAfter"/>
        </StackPanel>
      </Grid>
      <Border x:Name="ErrorPanel" Grid.Row="1" Background="#FFF0DC" Padding="13,10" Margin="0,12,0,7" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="ErrorText" AutomationProperties.LiveSetting="Assertive" Foreground="#9C6B37" TextWrapping="Wrap" FontSize="12"/>
      </Border>
      <Grid Grid.Row="2" VerticalAlignment="Bottom">
        <Button x:Name="Back" Content="←  返回" HorizontalAlignment="Left" Background="Transparent" Padding="0,12,20,12" Visibility="Collapsed" AutomationProperties.AutomationId="Back"/>
        <TextBlock x:Name="FooterNote" Text="WINDOWS x64" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" FontSize="11"/>
        <Button x:Name="PrimaryAction" Content="开始设置  →" Style="{StaticResource Primary}" HorizontalAlignment="Right" IsDefault="True" AutomationProperties.AutomationId="PrimaryAction"/>
      </Grid>
    </Grid>
    <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Height="56" VerticalAlignment="Top" Background="Transparent">
      <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Grid Width="22" Height="22" Background="#75AC45" Margin="0,0,11,0">
          <Viewbox><Canvas Width="32" Height="32"><Path Data="M17 7h8v5h-3v3h-5ZM7 10h7v3h3v5h-6v-3H7ZM14 15h4v10h-4Z" Fill="#F5F5DE"/></Canvas></Viewbox>
        </Grid>
        <TextBlock Text="青禾 Studio" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock x:Name="VersionLabel" Margin="18,0,0,0" FontFamily="Consolas" FontSize="11" Foreground="#93A47E" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
        <Button x:Name="Minimize" Content="─" Padding="0" Width="32" Height="30" Background="Transparent" AutomationProperties.Name="最小化" ToolTip="最小化"/>
        <Button x:Name="Close" Content="×" FontSize="20" Padding="0" Width="32" Height="30" Background="Transparent" AutomationProperties.Name="关闭安装器" AutomationProperties.AutomationId="Close" ToolTip="关闭"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
